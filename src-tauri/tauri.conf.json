{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "V Assistant",
  "version": "1.1.40",
  "identifier": "com.vuaai.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1NDVBMTdFODUxMUEyRjkKUldUNW9oR0ZmcUZGVll1NHdiRnZ0N2FwOG8vRHdMUG05TlJjMmRJVU5BVVA5L2JJK0tSaXlGUUgK",
      "endpoints": [
        "https://github.com/360org/v-assistant/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "title": "V Assistant",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "360org",
    "homepage": "https://vuaai.net",
    "copyright": "\u00a9 360org \u2014 vuaai.net",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../agent-runner/**/*",
      "../ai-router/**/*",
      "../runtime/node/**/*"
    ]
  }
}
