{
  "name": "v-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "V Assistant — AI for everyone. Download, install, login, connect, start.",
  "author": {
    "name": "360org",
    "email": "support@vuaai.net",
    "url": "https://vuaai.net"
  },
  "homepage": "https://vuaai.net",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/validate-skills.mjs && tsc && vite build",
    "check": "npm run build && node scripts/tool-loop-check.mjs && node scripts/telegram-check.mjs && node scripts/schedule-check.mjs && node scripts/login-check.mjs && node scripts/isolation-check.mjs && node scripts/self-improve-check.mjs && node scripts/connector-check.mjs",
    "version:set": "node scripts/bump-version.mjs",
    "build:demo": "vite build -c vite.demo.config.ts && node scripts/inline-demo.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.7"
  }
}
