#!/usr/bin/env bash
# ┌──────────────────────────────────────────────────┐
# │  V-Assistant — Script quản lý phát triển         │
# │  Tương tự script `claw` của OpenClaw             │
# │                                                  │
# │  Cách dùng:                                      │
# │    ./dev up       Khởi động Agent Runner         │
# │    ./dev down     Dừng và xóa container          │
# │    ./dev restart  Khởi động lại                  │
# │    ./dev logs     Xem log thời gian thực         │
# │    ./dev status   Kiểm tra trạng thái            │
# │    ./dev shell    Mở shell vào container         │
# │    ./dev demo     Gửi message test vào runner    │
# │    ./dev reset    Xóa sạch data, chạy lại        │
# │    ./dev ui       Chạy Vite UI dev server        │
# │    ./dev all      Chạy cả UI + Agent Runner      │
# └──────────────────────────────────────────────────┘
set -euo pipefail

# Lấy đường dẫn thực (hỗ trợ symlink)
SCRIPT_REAL="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
ROOT="$(cd "$(dirname "$SCRIPT_REAL")" && pwd)"
cd "$ROOT"

# File compose
COMPOSE_RUNNER="$ROOT/docker-compose.agent-runner.yml"
COMPOSE_UI="$ROOT/docker-compose.dev.yml"
PROJECT="v-assistant"

# --- Colima runtime (macOS) ---
ensure_docker() {
  # Kiểm tra Docker đang chạy
  if ! docker info >/dev/null 2>&1; then
    # Thử Colima trước (macOS)
    if command -v colima >/dev/null 2>&1; then
      if ! colima status >/dev/null 2>&1; then
        echo "▸ Khởi động Colima…"
        colima start
      fi
      docker context use colima >/dev/null 2>&1 || true
    else
      echo "❌ Docker chưa chạy. Hãy khởi động Docker Desktop hoặc Colima." >&2
      exit 1
    fi
  fi
}

# Compose helper
compose_runner() {
  docker compose -p "$PROJECT" -f "$COMPOSE_RUNNER" "$@"
}

compose_ui() {
  docker compose -p "${PROJECT}-ui" -f "$COMPOSE_UI" "$@"
}

# Hàm hiển thị hướng dẫn
usage() {
  echo ""
  echo "  V-Assistant — Script quản lý phát triển"
  echo ""
  echo "  Cách dùng: ./dev [lệnh]"
  echo ""
  echo "  Agent Runner:"
  echo "    up           Khởi động Agent Runner (background)"
  echo "    down         Dừng và xóa container"
  echo "    restart      Khởi động lại (không build lại image)"
  echo "    logs         Xem log thời gian thực"
  echo "    status       Kiểm tra trạng thái container"
  echo "    shell        Mở shell vào container runner"
  echo "    demo         Gửi message test vào runner"
  echo "    reset        Xóa sạch volumes, chạy lại từ đầu"
  echo ""
  echo "  Vite UI:"
  echo "    ui           Chạy Vite dev server (http://localhost:1420)"
  echo "    ui-down      Dừng Vite dev server"
  echo ""
  echo "  Tổng hợp:"
  echo "    all          Chạy cả UI + Agent Runner"
  echo "    all-down     Dừng tất cả"
  echo ""
  echo "  Biến môi trường:"
  echo "    VUA_PROVIDER    Provider AI (openai/anthropic/gemini/local)"
  echo "    VUA_API_KEY     API key cho provider"
  echo "    VUA_MODEL       Model ID (vd: gpt-4o, claude-sonnet-4-20250514)"
  echo ""
  echo "  Ví dụ:"
  echo "    ./dev up"
  echo "    VUA_API_KEY=sk-xxx VUA_PROVIDER=openai ./dev up"
  echo "    ./dev demo"
  echo "    ./dev logs"
  echo ""
  exit 0
}

# =============================================================================
# COMMANDS
# =============================================================================

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
  # --- Agent Runner ---
  up)
    ensure_docker
    echo "▸ Khởi động V-Assistant Agent Runner…"
    compose_runner up -d agent-runner
    echo ""
    echo "✅ Agent Runner đang chạy."
    echo "   Xem logs:  ./dev logs"
    echo "   Test:      ./dev demo"
    echo "   Dừng:      ./dev down"
    ;;

  down)
    ensure_docker
    compose_runner down
    echo "✅ Đã dừng Agent Runner."
    ;;

  restart)
    ensure_docker
    echo "▸ Khởi động lại Agent Runner (không build lại image)…"
    compose_runner restart agent-runner
    echo "✅ Đã restart. Xem logs: ./dev logs"
    ;;

  logs)
    ensure_docker
    compose_runner logs -f agent-runner
    ;;

  status|ps)
    ensure_docker
    echo "=== Agent Runner ==="
    compose_runner ps
    echo ""
    # Kiểm tra heartbeat file
    local_ipc_vol=$(docker volume inspect "${PROJECT}_ipc-data" --format '{{.Mountpoint}}' 2>/dev/null || echo "")
    if [ -n "$local_ipc_vol" ]; then
      echo "=== IPC databases ==="
      docker run --rm -v "${PROJECT}_ipc-data:/data" alpine ls -la /data/ipc/ 2>/dev/null || echo "(chưa có file IPC)"
    fi
    ;;

  shell|sh)
    ensure_docker
    echo "▸ Mở shell vào Agent Runner…"
    compose_runner exec agent-runner sh
    ;;

  demo|test)
    ensure_docker
    echo "▸ Gửi message test vào Agent Runner…"
    compose_runner run --rm demo
    ;;

  reset)
    ensure_docker
    echo "▸ Xóa sạch containers + volumes, chạy lại từ đầu…"
    compose_runner down -v
    compose_runner up -d agent-runner
    echo "✅ Đã reset. Xem logs: ./dev logs"
    ;;

  # --- Vite UI ---
  ui)
    ensure_docker
    echo "▸ Khởi động Vite UI dev server…"
    compose_ui up -d
    echo ""
    echo "⏳ Chờ Vite khởi động…"
    for _ in $(seq 1 30); do
      if curl -fsS -o /dev/null "http://localhost:1420" 2>/dev/null; then
        echo "✅ UI Ready → http://localhost:1420"
        break
      fi
      sleep 2
    done
    ;;

  ui-down)
    ensure_docker
    compose_ui down
    echo "✅ Đã dừng Vite UI."
    ;;

  # --- All ---
  all)
    ensure_docker
    echo "▸ Khởi động tất cả (UI + Agent Runner)…"
    compose_runner up -d agent-runner
    compose_ui up -d
    echo ""
    echo "✅ Đang chạy:"
    echo "   UI:     http://localhost:1420"
    echo "   Runner: ./dev logs"
    ;;

  all-down)
    ensure_docker
    compose_runner down
    compose_ui down
    echo "✅ Đã dừng tất cả."
    ;;

  # --- Help ---
  help|-h|--help)
    usage
    ;;

  *)
    echo "❌ Lệnh không hợp lệ: $cmd" >&2
    usage
    ;;
esac
